{
  "name": "media-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "bin": {
    "media-manager": "./src/client/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "server": "tsx src/server/index.ts",
    "client": "tsx src/client/index.ts",
    "webui": "pnpm --filter media-manager-webui dev",
    "webui:build": "pnpm --filter media-manager-webui build",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@prisma/client": "7.10.1",
    "commander": "15.1.0",
    "dotenv": "18.0.10",
    "duplicate-image-detector": "0.4.1",
    "exifr": "7.1.3",
    "openai": "7.57.0",
    "prisma-pglite": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
